# ─────────────────────────────────────────────────────────────────────────────
# Boonma Farm — production environment for docker compose on the droplet.
#
#   cp .env.prod.example .env
#   chmod 600 .env          # readable only by the deploy user
#   # then fill EVERY value below (compose will refuse to start otherwise)
#
# .env is gitignored (deploy/.gitignore) — it must NEVER be committed.
# Generate each secret with:   openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
# ─────────────────────────────────────────────────────────────────────────────

# Lets `docker compose ...` in this directory find the prod file with no -f flag.
COMPOSE_FILE=docker-compose.prod.yml

# ── Which image to run ───────────────────────────────────────────────────────
# Normally :latest (CI pushes it every deploy). To roll back, pin a :sha-xxxxxxxx.
APP_IMAGE=ghcr.io/weeranieb/farmmanagementapi:latest

# ── PostgreSQL: superuser (maintenance / break-glass only — the app never uses it)
POSTGRES_DB=boonmafarm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=            # REQUIRED — strong, 32+ chars

# ── PostgreSQL: least-privilege roles (created on first boot) ────────────────
APP_DB_USER=app_user
APP_DB_PASSWORD=             # REQUIRED — the API connects with this (DML only)

READONLY_DB_USER=readonly_user
READONLY_DB_PASSWORD=       # REQUIRED — reporting / analytics (SELECT only)

SYS_ADMIN_DB_USER=sys_admin
SYS_ADMIN_DB_PASSWORD=      # REQUIRED — schema owner; runs migrations (no superuser)

# ── Application auth ─────────────────────────────────────────────────────────
AUTHENTICATION_JWT_SECRET=  # REQUIRED — 32+ random chars; app refuses to boot if empty
AUTHENTICATION_JWT_EXPIRY=24h

# ── CORS: lock to the prod frontend origin (Vercel). No wildcard. ────────────
# Comma-separate if you must allow more than one (e.g. staging).
CORS_ALLOWED_ORIGINS=https://app.boonmafarm.com

APP_LOG_LEVEL=info

# ── Caddy / TLS ──────────────────────────────────────────────────────────────
API_DOMAIN=api.boonmafarm.com
ACME_EMAIL=                  # REQUIRED — Let's Encrypt expiry notices go here

# ── Backups (used by scripts/backup.sh; can live in a separate .env.backup) ──
# SPACES_BUCKET=boonmafarm-backups
# SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# RETENTION_DAYS=7
